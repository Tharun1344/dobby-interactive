# ─────────────────────────────────────────────────────────────────────────────
# .movie / .film — CineSubz film downloader
# Append to config.env (or .env). Every value below is optional.
# Full guide: README-SI.md, INTEGRATION.md.
# ─────────────────────────────────────────────────────────────────────────────

# Source host. Change only if CineSubz moves to another domain.
FILM_SITE=https://cinesubz.net

# Where downloads are written. Empty = <STORAGE_DIR>/data/films
FILM_DOWNLOAD_DIR=

# WhatsApp document ceiling. 1.9 GB leaves headroom below WhatsApp's ~2 GB.
FILM_MAX_BYTES=1900000000

# Maximum films downloading at once across every chat.
FILM_MAX_CONCURRENT=2

# Delete the cloud file immediately after WhatsApp accepts the document.
FILM_DELETE_AFTER_SEND=true

# Delete a partial file when the user cancels (false = keep for resume).
FILM_DELETE_PARTIAL_ON_CANCEL=true

# Per-sender search cooldown and prompt validity.
FILM_COOLDOWN_MS=8000
FILM_PROMPT_TTL_MS=600000

# HTTP timeout for search/player/API calls.
FILM_REQUEST_TIMEOUT_MS=45000

# DuckDuckGo fallback when the site search returns nothing.
FILM_DDG_FALLBACK=true

# ─────────────────────────────────────────────────────────────────────────────
# Legacy movie catalogue / metadata
# .movie no longer uses these. Kept for .pdl, scripts/test-movie.js and any
# deployment that still reads the old catalogue.
# ─────────────────────────────────────────────────────────────────────────────
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
MOVIE_REGION=US
MOVIE_PROVIDERS=catalog,tmdb
MOVIE_CATALOG_PATH=./data/movies.json
MOVIE_AUTO_SEND_MEDIA=false
MOVIE_ALWAYS_CARD=false
MOVIE_SEND_POSTER=true
MOVIE_COOLDOWN_MS=15000
MOVIE_MAX_CONCURRENT=3
MOVIE_WA_VIDEO_LIMIT_BYTES=67108864
MOVIE_WA_DOC_LIMIT_BYTES=1900000000
MOVIE_DOWNLOAD_TIMEOUT_MS=900000
MOVIE_FETCH_TIMEOUT_MS=12000
MOVIE_CACHE_TTL_MS=21600000

# ─────────────────────────────────────────────────────────────────────────────
# Optional headless-browser provider (see INTEGRATION.md)
# Requires: npm i playwright && npx playwright install chromium
# ─────────────────────────────────────────────────────────────────────────────
BROWSER_ENABLED=false
BROWSER_IDLE_MS=60000
BROWSER_MAX_CONCURRENCY=2
BROWSER_TIMEOUT_MS=30000
BROWSER_BLOCK_MEDIA=true
# Set true only inside containers without user namespaces (Docker/Railway)
BROWSER_NO_SANDBOX=false

# ─────────────────────────────────────────────────────────────────────────────
# Optional Playwright download engine (.pdl) — see PLAYWRIGHT-SETUP.md
# Only for sources you own / are licensed to distribute from.
# ─────────────────────────────────────────────────────────────────────────────
PLAYWRIGHT_DOWNLOAD_ENABLED=false
PDL_CONFIG=./data/download-sources.json
# PDL_SOURCE=my-catalogue
PDL_MAX_BYTES=1900000000
PDL_MAX_CONCURRENT=1
PDL_DOWNLOAD_START_MS=30000
PDL_NAV_TIMEOUT_MS=30000
PDL_TOTAL_TIMEOUT_MS=300000

# --- Interactive menus (.menu) ----------------------------------------------
# Full guide: INTERACTIVE-MENUS.md. All values are optional.
# false = .menu uses the classic text command list instead of buttons/lists.
INTERACTIVE_ENABLED=true
# true = always send numbered text menus, even in normal chats.
INTERACTIVE_TEXT_ONLY=false
# Add the WhatsApp "bot" node to private-chat quick replies.
INTERACTIVE_BOT_NODE=true
# Menu/navigation lifetime (minutes, minimum 1).
INTERACTIVE_STATE_TTL_MIN=30
# Pending prompt/confirmation lifetime (minutes, minimum 1).
INTERACTIVE_PROMPT_TTL_MIN=10
# Maximum live per-user menu states in memory.
INTERACTIVE_STATE_MAX=2000
