# Playwright + Chromium image for DANUWA-MD (.movie download engine).
#
# IMPORTANT: the image tag MUST match the playwright version below.
#   FROM mcr.microsoft.com/playwright:v1.47.0-jammy
#   npm install ... playwright@1.47.0
# Change both together, or Chromium will not launch.
#
# Keep yt-dlp/ffmpeg from the original Dockerfile so existing commands
# (.song, .ytvideo, .sticker ...) keep working.

FROM mcr.microsoft.com/playwright:v1.47.0-jammy

# Original bot dependencies (ffmpeg + yt-dlp) stay installed.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg ca-certificates python3 python3-pip \
 && python3 -m pip install --break-system-packages --no-cache-dir -U "yt-dlp[default]" \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
# The base image already contains the browsers; skip the download step.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# --no-save keeps package.json/lock untouched while still installing the
# client library that ships in the base image.
RUN npm install --omit=dev --no-audit --no-fund \
 && npm install --no-save --no-audit --no-fund playwright@1.47.0

COPY . .

ENV NODE_ENV=production \
    BROWSER_ENABLED=true \
    BROWSER_NO_SANDBOX=true \
    BROWSER_IDLE_MS=60000 \
    BROWSER_MAX_CONCURRENCY=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_DOWNLOAD_ENABLED=true

# Railway injects $PORT. The bot's express health endpoint is /health.
EXPOSE 8000

CMD ["npm", "start"]
