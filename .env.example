# Owner phone number in international digits, without +
BOT_OWNER=YOUR_COUNTRY_CODE_AND_NUMBER
# Image shown with .alive. Must be a direct, public image URL (not a Facebook/Instagram
# page link — those don't work). Easiest options: upload the photo to your GitHub repo and
# use the "raw.githubusercontent.com" link, or host it on any public image host.
ALIVE_IMG=
OWNER_NAME=Tharun Prabashwara
OWNER_GITHUB=https://github.com/tharunprabashwara642-dot
# Set your real website/social links; blank links are hidden in .alive/.menu
OWNER_WEBSITE=https://tharun-liard.vercel.app/
OWNER_WHATSAPP=https://wa.me/94707915458
OWNER_FACEBOOK=https://www.facebook.com/share/1F7ZFB6jsy/?mibextid=wwXIfr
OWNER_INSTAGRAM=
OWNER_TELEGRAM=
OWNER_YOUTUBE=
BOT_NAME=Tharun's WhatsApp Bot
PREFIX=.
STORAGE_DIR=/data
BOT_MODE=public
ANTIDELETE_ENABLED=true
# One-time greeting sent to a new private chat the first time it messages the bot.
# Leave blank to use the built-in default (uses BOT_NAME/OWNER_NAME automatically).
GREETING_MSG=
# .alive sends native URL buttons only when true. Baileys 6.7 does not support
# cta_url on every client, so the default is a separate, clearly-labelled text
# links message. The main status card never contains raw URLs.
ALIVE_URL_BUTTONS=false
# WhatsApp's practical max is around 2 GB; this is capped below 1.9 GB to leave headroom.
MAX_DOWNLOAD_BYTES=1900000000
DOWNLOAD_TIMEOUT_MS=600000
# Multiple accounts: each account must be paired separately; persistent volume required
# BOT_ACCOUNTS=[{"id":"main","ownerNumber":"YOUR_NUMBER","sessionId":""},{"id":"work","ownerNumber":"YOUR_NUMBER","sessionId":""}]
# Optional Supabase audit log integration (never put keys in source control)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_AUDIT_TABLE=bot_audit_events
# Gemini (used by .ai and .vision). Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.5-flash-lite
AI_VISION_MODEL=gemini-3.5-flash-lite
# Scheduled messages use Sri Lanka time (UTC+5:30 = 330 minutes)
TZ_OFFSET_MIN=330
# YTDLP_BIN=yt-dlp

# Optional tuning for video sending (defaults shown)
# WA_VIDEO_LIMIT_BYTES=62914560
# FFMPEG_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# .movie / .film — CineSubz film downloader (downloads on the bot host and
# sends the film to WhatsApp as a document). Runs on a PC or a cloud container.
# Needs enough disk/volume for one film at a time (2-5 GB free recommended).
# ---------------------------------------------------------------------------
# Source host. Change only if CineSubz moves to another domain.
FILM_SITE=https://cinesubz.net
# Where downloads are written. Empty = <STORAGE_DIR>/data/films
FILM_DOWNLOAD_DIR=
# WhatsApp document ceiling. 1.9 GB leaves headroom below WhatsApp's ~2 GB.
FILM_MAX_BYTES=1900000000
# Maximum films downloading at once across every chat.
FILM_MAX_CONCURRENT=2
# Delete the cloud file immediately after WhatsApp accepts the document.
FILM_DELETE_AFTER_SEND=true
# Delete a partial file when the user cancels (false = keep for resume).
FILM_DELETE_PARTIAL_ON_CANCEL=true
# Per-sender search cooldown and how long a quality/choice prompt stays valid.
FILM_COOLDOWN_MS=8000
FILM_PROMPT_TTL_MS=600000
# Optional: DuckDuckGo fallback when the site search returns nothing.
FILM_DDG_FALLBACK=true

# --- Legacy movie catalogue / metadata (used by .pdl and tests) -------------
# .movie itself no longer uses this catalogue. Kept for compatibility.
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
MOVIE_CATALOG_PATH=./data/movies.json
MOVIE_PROVIDERS=catalog,tmdb
# false = always send the text card; true = also download direct offers
MOVIE_AUTO_SEND_MEDIA=false
MOVIE_SEND_POSTER=true

# --- Optional browser engine (.moviestatus / .pdl) --------------------------
# Needs: npm i playwright && npx playwright install chromium
BROWSER_ENABLED=false
BROWSER_NO_SANDBOX=false          # true inside Docker / Railway
BROWSER_MAX_CONCURRENCY=1

# --- Optional Playwright downloader (.pdl, owner only) ----------------------
# Only for sources you own or are licensed to distribute from.
PLAYWRIGHT_DOWNLOAD_ENABLED=false
PDL_CONFIG=./data/download-sources.json
PDL_MAX_BYTES=1900000000
PDL_MAX_CONCURRENT=1

# ---------------------------------------------------------------------------
# Interactive button / list menus (.menu). See INTERACTIVE-MENUS.md.
# Every existing text command keeps working whether this is on or off.
# Owners can also switch per account at runtime: .buttons (interactive) and
# .text (classic). That preference is saved in data/menu-mode.json and never in
# WhatsApp session files. The two variables below always win over those commands.
# ---------------------------------------------------------------------------
# true = .menu opens native buttons/lists (with automatic text fallback).
# false = .menu goes straight to the classic text command list.
INTERACTIVE_ENABLED=true
# true = always send numbered text menus, even in normal chats. Use this if
# your WhatsApp client does not render native buttons/lists reliably.
INTERACTIVE_TEXT_ONLY=false
# Adds the WhatsApp "bot" node to native quick replies in private chats.
# Set false if you do not want the AI/bot badge on those messages.
INTERACTIVE_BOT_NODE=true
# How long an open menu/navigation stack stays usable (minutes; minimum 1).
INTERACTIVE_STATE_TTL_MIN=30
# How long a pending prompt or confirmation waits for an answer (minutes; minimum 1).
INTERACTIVE_PROMPT_TTL_MIN=10
# Maximum number of concurrent per-user menu states kept in memory.
INTERACTIVE_STATE_MAX=2000
